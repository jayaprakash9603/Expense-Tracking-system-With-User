# Docker Compose environment (copy to .env and adjust as needed)
# cp .env.example .env

# ---------------------------------------------------------------------------
# Image registry and versioning
# ---------------------------------------------------------------------------
# Docker Hub username or private registry host (no trailing slash)
DOCKER_REGISTRY=jayaprakash9603

# Monolith backend version — keep in sync with VERSION file and monolithic-service/pom.xml
MONOLITH_VERSION=1.1.0

# Frontend image version — keep in sync with expense-tracking-frontend/package.json
FRONTEND_VERSION=0.1.0

# Optional: append git short SHA to image tags (true/false)
IMAGE_TAG_WITH_GIT_SHA=false

# ---------------------------------------------------------------------------
# Ports (host)
# ---------------------------------------------------------------------------
MYSQL_PORT=4000
MONOLITH_PORT=8080
FRONTEND_PORT=9999

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=expense_tracker_monolith

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-secret-key-change-in-production-min-32-chars
SERVICE_INTERNAL_TOKEN=dev-internal-service-token-change-in-production

# Disable optional infra in monolith mode (no Kafka / Redis containers required)
KAFKA_ENABLED=false
REDIS_ENABLED=false

# ---------------------------------------------------------------------------
# Frontend build-time (browser calls backend on host port)
# ---------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:8080
