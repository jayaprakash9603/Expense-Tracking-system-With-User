# Vite reads variables prefixed with REACT_APP_ (backward compatible) and VITE_.
# Both are exposed to source code via `process.env.<NAME>` at build time.

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8080

# For production deployment, use HTTPS:
# REACT_APP_API_BASE_URL=https://api.your-domain.com

# Microservices: set to true so notification SockJS connects to Notification-Service
# REACT_APP_MICROSERVICES=true

# Optional: Notification-Service origin when REACT_APP_MICROSERVICES=true
# REACT_APP_NOTIFICATION_SERVICE_BASE_URL=http://localhost:6003

# Optional: full SockJS URL
# REACT_APP_NOTIFICATION_WS_URL=http://localhost:6003/notifications
