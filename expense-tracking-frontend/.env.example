# Google OAuth Configuration
# Get your Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials

REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here

# API Configuration
# Set the backend API base URL (use HTTPS in production)
REACT_APP_API_BASE_URL=http://localhost:8080

# For production deployment, use HTTPS:
# REACT_APP_API_BASE_URL=https://api.your-domain.com

# Microservices: set to true so notification SockJS connects to Notification-Service
# (default http://localhost:6003/notifications), not the monolith/gateway port.
# Monolithic: omit or false — notifications use {REACT_APP_API_BASE_URL}/notifications (e.g. :8080).
# REACT_APP_MICROSERVICES=true

# Optional: Notification-Service origin when REACT_APP_MICROSERVICES=true (no trailing slash)
# REACT_APP_NOTIFICATION_SERVICE_BASE_URL=http://localhost:6003

# Optional: full SockJS URL (overrides microservices and monolithic defaults)
# REACT_APP_NOTIFICATION_WS_URL=http://localhost:6003/notifications
